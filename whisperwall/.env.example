# Django Configuration
# Copy this file to .env and fill in the values for your environment

# Secret key for production (generate a strong one!)
# For production, generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-super-secret-key-here

# Set to False for production
DJANGO_DEBUG=True

# Optional: Database URL (for production with PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/whisperwall

# Optional: Allowed hosts (comma-separated)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
