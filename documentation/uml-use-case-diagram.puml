@startuml
left to right direction
skinparam packageStyle rectangle

actor Guest
actor "Registered User" as User
actor Admin

rectangle WhisperWall {
  usecase "Sign up" as UC1
  usecase "Log in" as UC2
  usecase "Log out" as UC3
  usecase "Submit confession" as UC4
  usecase "View my confessions" as UC5
  usecase "View matches" as UC6
  usecase "Chat with match" as UC7
  usecase "Request reveal" as UC8
  usecase "Activate contact exchange" as UC9
  usecase "Manage academic profile" as UC10
  usecase "View events" as UC11
  usecase "Watch live session" as UC12
  usecase "Review system data" as UC13
}

Guest --> UC1
Guest --> UC2
Guest --> UC11
Guest --> UC12

User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11
User --> UC12

Admin --> UC13

UC4 .> UC6 : triggers matching
UC8 .> UC9 : may lead to
UC9 .> UC10 : optionally reveals profiles

@enduml
